rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }
    
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string 
        && data.role in ['donor', 'hospital', 'admin']
        && data.keys().hasAll(['uid', 'email', 'role'])
        && data.keys().size() <= 6;
    }

    function isValidDonor(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() < 100
        && data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
        && data.city is string && data.city.size() < 50
        && data.keys().hasAll(['userId', 'name', 'bloodGroup', 'city'])
        && data.keys().size() <= 12;
    }

    function isValidRequest(data) {
      return data.requesterId == request.auth.uid
        && data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
        && data.unitsNeeded is number && data.unitsNeeded > 0
        && data.urgency in ['Normal', 'High', 'Critical']
        && data.status in ['Pending', 'Fulfilled', 'Cancelled']
        && data.keys().hasAll(['requesterId', 'bloodGroup', 'unitsNeeded', 'urgency', 'status'])
        && data.keys().size() <= 12;
    }

    // --- Match Rules ---

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) 
        && isValidUser(incoming())
        && (incoming().role == existing().role || isAdmin()); // Users cannot change their own role unless admin
    }

    match /donors/{donorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidDonor(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (isOwner(existing().userId) || isAdmin()) 
        && (incoming().userId == existing().userId)
        && isValidDonor(incoming())
        && (incoming().isApproved == existing().isApproved || isAdmin()); // Only admin can approve
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if true; // Publicly viewable for help
      allow create: if isSignedIn() && isValidRequest(incoming());
      allow update: if (isOwner(existing().requesterId) || isAdmin()) 
        && isValidRequest(incoming())
        && (existing().status == 'Pending' || isAdmin()); // Cannot change after fulfilled/cancelled unless admin
      allow delete: if isAdmin();
    }

    match /inventory/{bloodGroup} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && getUserRole() == 'hospital');
    }
  }
}
